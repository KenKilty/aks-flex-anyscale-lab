flowchart LR
  client["Client<br/>Anyscale Console or Anyscale CLI"]

  subgraph controlPlane["Anyscale control plane"]
    jobManager["Job management<br/>records the DeepSpeed Ray Train Job"]
  end

  subgraph azureSubscription["Your Azure subscription"]
    operator["Anyscale operator<br/>polls for pending work"]
    kubernetesApi["Kubernetes API<br/>accepts Ray resources"]
    scheduler["Kubernetes scheduler<br/>places the Ray pods"]
    head["Ray head pod<br/>AKS-managed CPU node"]
    managedWorker["Ray worker pod<br/>AKS-managed node"]
    flexWorker["Ray worker pod<br/>Flex node in the second region"]

    operator -->|creates Ray resources| kubernetesApi
    kubernetesApi --> scheduler
    scheduler --> head
    scheduler --> managedWorker
    scheduler --> flexWorker
  end

  client -->|submits the Job| jobManager
  operator -->|polls outbound for pending work| jobManager

