# Keep executable and tool-consumed text files compatible with Linux tooling,
# including when the repository is cloned on Windows with core.autocrlf enabled.
* text=auto eol=lf

*.sh     text eol=lf
*.bash   text eol=lf
*.tf     text eol=lf
*.tfvars text eol=lf
*.hcl    text eol=lf
*.py     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary