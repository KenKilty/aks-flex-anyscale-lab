# Environment configuration for the AKS Flex Node + Anyscale sample.
#
# Start here:
#   1. Copy this file: cp .env-template .env
#   2. Set the values marked "Change this" below.
#   3. Keep .env on your computer. It can contain identifiers for your Azure
#      subscription and must never be committed.
#
# This file uses shell-compatible KEY="value" lines. Keep the quotes, and keep
# JSON values on one line. The setup helper reads this file and writes TF_VAR_*
# values to infra/terraform/terraform.auto.tfvars.json before Terraform runs.
#
# You can keep more than one local profile without changing .env. Point the
# helper at another file with:
#   ANYSCALE_AKS_ENV_FILE=<file> ./scripts/anyscale-aks.sh <command>
#
# Change this first: Azure IDs, the Owner tag, and SSH_PRIVATE_KEY_PATH. Review
# the region pair and network ranges before deploying. Leave the remaining
# defaults in place unless the comments say that a later module enables them.

###############################################################################
# Azure operator context
###############################################################################
# Change this: use the subscription and tenant that will own the lab resources.
# ARM_USE_CLI=true uses your existing Azure CLI sign-in, so you do not place an
# Azure password or service principal secret in this file.
ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"
ARM_USE_CLI="true"

# These repeat the same IDs for Terraform. Keep ARM_* and TF_VAR_* values in
# sync so Azure CLI and Terraform work in the same subscription and tenant.
TF_VAR_azure_subscription_id="00000000-0000-0000-0000-000000000000"
TF_VAR_azure_tenant_id="00000000-0000-0000-0000-000000000000"

###############################################################################
# Deployment naming and locations
###############################################################################
TF_VAR_project="flexany"
TF_VAR_environment="dev"

# Public-only CPU baseline for this lab. Update the region pair only if you have
# verified that the target AKS region supports the Anyscale operator extension
# and both regions have quota for the selected VM sizes.
# Change this together: the home region hosts AKS and the Flex region hosts the
# external Flex VM. region_short values become part of Azure resource names, so
# use short lowercase labels and do not change them after the first apply.
TF_VAR_azure_location="westus2"
TF_VAR_region_short="wus2"
TF_VAR_flex_region="westus3"
TF_VAR_flex_region_short="wus3"
# Change this: replace change-me with a person, team, or cost-center label that
# can answer questions about the resources. Keep the JSON on one line.
TF_VAR_tags='{"Project":"flexany","Environment":"dev","ManagedBy":"terraform","Owner":"change-me"}'
# Change this if your SSH key lives elsewhere. Module 3 uses the matching .pub
# file to access the Flex VM. Do not put the private-key contents in this file.
SSH_PRIVATE_KEY_PATH="${HOME:-/home/${USER:-azureoperator}}/.ssh/id_ed25519"

###############################################################################
# Core networking
###############################################################################
# Review this before deploying: these address ranges must not overlap with your
# home network, VPN, on-premises network, or other Azure networks you need to
# reach. Keep the DNS service IP inside the service CIDR.
TF_VAR_vnet_address_space='["10.50.0.0/16"]'
TF_VAR_subnet_cidrs='{"firewall":"10.50.0.0/26","bastion":"10.50.0.128/26","dns_resolver_in":"10.50.1.16/28","dns_resolver_out":"10.50.1.32/28","aks_nodes":"10.50.4.0/22"}'
TF_VAR_flex_vnet_address_space='["10.60.0.0/16"]'
TF_VAR_flex_subnet_cidr="10.60.1.0/24"
# Azure CNI Overlay allocates this pod CIDR to AKS-managed nodes.
TF_VAR_cilium_pod_cidr="10.83.0.0/16"
# Unbounded allocates this separate pod CIDR to Flex nodes. Neither pod CIDR
# may overlap the AKS VNet, Flex VNet, service CIDR, or a connected network.
TF_VAR_unbounded_flex_pod_cidr="10.84.0.0/16"
TF_VAR_service_cidr="10.100.0.0/16"
TF_VAR_dns_service_ip="10.100.0.10"
TF_VAR_dns_forwarding_rules='{}'

###############################################################################
# AKS sizing
###############################################################################
# These sizes define the starting CPU profile. Check regional quota before
# changing them. The system pool runs AKS services; the CPU pool runs the Ray
# head and other ordinary workload pods.
TF_VAR_availability_zones='["1","2","3"]'
TF_VAR_aks_sku_tier="Standard"
TF_VAR_kubernetes_version='"1.34.6"'
TF_VAR_system_node_pool_min_count="1"
TF_VAR_system_node_pool_max_count="3"
TF_VAR_system_vm_size="Standard_D4s_v5"
TF_VAR_cpu_vm_size="Standard_D16s_v5"
TF_VAR_aks_defender_enabled="false"
# Leave empty for the CPU lab. Add a GPU pool only when you intend to run the
# GPU path and have quota for the selected GPU VM size.
TF_VAR_gpu_pool_configs='{}'

###############################################################################
# Flex host provisioning
###############################################################################
# The Flex VM is part of every lab deployment and starts Azure compute charges
# when Module 2 creates the environment.
TF_VAR_flex_host_enabled="true"
# The CPU lab uses Standard_D4s_v5. Change this to a supported GPU VM size only
# for the GPU path, after confirming quota in TF_VAR_flex_region.
TF_VAR_flex_host_vm_size="Standard_D4s_v5"
TF_VAR_flex_host_admin_username="azureoperator"
# Leave blank to auto-load from ${SSH_PRIVATE_KEY_PATH}.pub when enabled.
TF_VAR_flex_host_admin_ssh_public_key=""
TF_VAR_flex_host_public_ip_enabled="true"
# Unbounded assigns Flex workload addresses from its pod CIDR, so this VM needs
# no secondary pod IP addresses.
TF_VAR_flex_host_secondary_ip_configurations='[]'
TF_VAR_flex_host_user_assigned_identity_ids='[]'
TF_VAR_flex_host_os_disk_size_gb="256"
# Use the Ubuntu 24.04 image validated by the upstream AKS Flex Node Cilium lab.
# The GPU module documents the required NVIDIA-ready image when
# ANYSCALE_FLEX_GPU_ENABLED is set to true.
TF_VAR_flex_host_source_image_reference='{"publisher":"Canonical","offer":"ubuntu-24_04-lts","sku":"server","version":"latest"}'
# This label groups the external node and is used by workload placement checks.
# Keep the default unless you also update the matching selectors in the scripts.
AKS_FLEX_AGENT_POOL_NAME="aksflexnodes"
# Leave false for the CPU lab. Turn this on with the GPU VM and image settings
# above only when you are intentionally testing GPU scheduling.
ANYSCALE_FLEX_GPU_ENABLED="false"
# Set the Kubernetes product label for the accelerator selected in
# TF_VAR_flex_host_vm_size.
ANYSCALE_RESULTS_GPU_PRODUCT_LABEL=""
ANYSCALE_RESULTS_GPU_TARGET="flex"
ANYSCALE_RESULTS_GPU_WORKER_COUNT="1"

###############################################################################
# Anyscale operator identity foundation
###############################################################################
# These names are used by the operator and its Kubernetes service account. Keep
# the defaults unless your organization already reserves these names.
TF_VAR_anyscale_operator_namespace="anyscale-operator"
TF_VAR_anyscale_operator_serviceaccount="anyscale-operator"
TF_VAR_anyscale_operator_identity='{"mode":"create"}'
# Leave false until Module 4. Setting this to true creates the Anyscale cloud,
# installs the AKS extension, and creates a public Gateway IP.
TF_VAR_anyscale_enabled="false"
# Stable is the recommended workshop channel. Use Preview only when the lab or
# an extension availability check specifically requires it.
TF_VAR_anyscale_release_train="Stable"
TF_VAR_anyscale_auth_audience="api://086bc555-6989-4362-ba30-fded273e432b/.default"
TF_VAR_anyscale_gateway_name="anyscale-gateway"
TF_VAR_anyscale_gateway_hostname=""
# This assigns the deploying Azure user the Anyscale Platform Administrator role
# at subscription scope. Keep it enabled for a workshop unless an administrator
# has already granted you an equivalent role.
TF_VAR_anyscale_platform_default_admin_assignment='{"enabled":true,"principal_type":"User","role_definition_name":"Anyscale Platform Administrator","scope":"subscription"}'
TF_VAR_anyscale_platform_role_assignments='{}'
TF_VAR_anyscale_platform_admin_role_assignments='{}'

###############################################################################
# Storage, registry, observability
###############################################################################
# These defaults keep the proof storage private, use zone-redundant storage when
# available, and collect the logs needed to troubleshoot the lab. Review your
# organization's retention and network-access requirements before changing them.
TF_VAR_storage_cors_rule='{"allowed_headers":["*"],"allowed_methods":["GET","POST","PUT","HEAD","DELETE"],"allowed_origins":["https://*.anyscale.com"],"expose_headers":["Accept-Ranges","Content-Range","Content-Length"],"max_age_in_seconds":0}'
TF_VAR_storage_replication_type="ZRS"
TF_VAR_acr_zone_redundancy_enabled="true"
TF_VAR_log_analytics_retention_days="30"
TF_VAR_log_analytics_internet_ingestion_enabled="false"
TF_VAR_log_analytics_internet_query_enabled="true"
TF_VAR_ampls_enabled="true"
TF_VAR_ampls_ingestion_access_mode="PrivateOnly"
TF_VAR_ampls_query_access_mode="Open"
TF_VAR_container_insights_v2_enabled="true"
TF_VAR_container_insights_streams='["Microsoft-ContainerInsights-Group-Default"]'
TF_VAR_container_insights_data_collection_interval="1m"
TF_VAR_container_insights_namespace_filtering_mode="Off"
TF_VAR_container_insights_namespaces='[]'
TF_VAR_terraform_managed_diagnostic_settings_enabled="true"

###############################################################################
# AKS RBAC
###############################################################################
# Keep this true for a self-guided lab so the Azure user running Terraform can
# administer and use the cluster. Set it false only when your platform team
# manages AKS access through the principal maps below.
TF_VAR_assign_current_principal_cluster_access="true"
TF_VAR_aks_cluster_admin_principal_ids='{}'
TF_VAR_aks_cluster_user_principal_ids='{}'
